{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "ipc": true,
  "exclusive": true,
  "passthrough": false,
  "output": ["DP-1", "eDP-1"],
  "height": 16,
  "margin-top": 8,
  "margin-bottom": 0,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,

  "modules-left": ["custom/nixos"],
  "modules-right": [
    "battery",
    "pulseaudio",
    "pulseaudio#microphone",
    "network",
    "bluetooth",
    "hyprland/workspaces",
    "custom/dnd",
    "clock",
  ],

  "custom/nixos": {
    "format": "",
    "tooltip": false,
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 10,
    },
    "format": "{capacity}%",
    "format-charging": "{capacity}%",
    "format-plugged": "{capacity}%",
    "tooltip": false,
  },

  "pulseaudio": {
    "format": "",
    "format-muted": "",
    "tooltip": false,
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "tooltip": false,
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip": false,
    "on-click": "vicinae open -q 'Manage Saved Networks'",
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "",
    "tooltip": false,
    "on-click": "vicinae open -q 'Bluetooth Devices'",
  },

  "hyprland/workspaces": {
    "format": "●",
    "on-click": "activate",
  },

  "custom/dnd": {
    "format": "{}",
    "exec": "makoctl mode | grep -q do-not-disturb && echo '' || echo ''",
    "on-click": "makoctl mode -t do-not-disturb; pkill -RTMIN+8 waybar",
    "interval": "once",
    "signal": 8,
    "tooltip": false,
  },

  "clock": {
    "interval": 1,
    "format": "{:%a, %b %d  %H:%M}",
    "tooltip": false,
  },
}
