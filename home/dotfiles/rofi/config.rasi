configuration {
    modi:                        "drun";
    font:                        "FiraCode Nerd Font 11";
    show-icons:                  false;
    display-drun:                "";
    drun-display-format:         "{name}";
    sidebar-mode:                false;
}

@theme "/dev/null"

* {
    bg:                          #131313AA;
    fg:                          #f2f2f2;
    accent:                      #A5ADCB;
    border-col:                  #A6DA95;
    selected-bg:                 #494D64;

    background-color:            transparent;
    text-color:                  @fg;
}

window {
    width:                       500px;
    background-color:            @bg;
    padding:                     30px;
    border-radius:               20px;
}

mainbox {
    spacing:                     0px;
    children:                    [ inputbar, listview ];
}

inputbar {
    spacing:                     10px;
    padding:                     10 20 10px;
    border:                      3 3 0 3px;
    border-color:                @border-col;
    children:                    [ entry ];
}

entry {
    placeholder:                 "Search Apps...";
    placeholder-color:           #5B6078;
}

listview {
    columns:                     1;
    lines:                       8;
    padding:                     0 10px;
    spacing:                     2px;
    cycle:                       true;
    dynamic:                     true;
    layout:                      vertical;
    border:                      0 3 3 3px;
    border-color:                @border-col;
}

element {
    padding:                     3px 10px;
}

element selected {
    background-color:            @selected-bg;
    text-color:                  @accent;
}

element-text {
    vertical-align:              0.5;
    text-color:                  inherit;
}
