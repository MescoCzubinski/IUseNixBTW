configuration {
    modi:                        "drun";
    font:                        "FiraCode Nerd Font 11";
    show-icons:                  true;
    icon-theme:                  "Reversal-dark";
    display-drun:                "";
    drun-display-format:         "{name}";
    sidebar-mode:                false;
}

@theme "/dev/null"

* {
    bg:                          #282c34;
    fg:                          #abb2bf;
    accent:                      #61afef;
    button:                      #4f5666;
    selected:                    #4f5666;

    background-color:            transparent;
    text-color:                  @fg;
}

window {
    width:                       500px;
    x-offset:                    0px;
    y-offset:                    0px;
    spacing:                     0px;
    padding:                     20px;
    margin:                      0px;
    color:                       @fg;
    background-color:            @bg;
    border-radius:               15px;
    border-color:                @button;
    border-width:                2px;
}

mainbox {
    spacing:                     15px;
    children:                    [ inputbar, listview ];
}

inputbar {
    spacing:                     10px;
    padding:                     10px;
    background-color:            @button;
    border-radius:               10px;
    children:                    [ prompt, entry ];
}

prompt {
    background-color:            transparent;
    text-color:                  @accent;
    vertical-align:              0.5;
}

entry {
    background-color:            transparent;
    text-color:                  @fg;
    placeholder:                 "Search Apps...";
    placeholder-color:           @fg;
    vertical-align:              0.5;
}

listview {
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     5px;
}

element {
    spacing:                     10px;
    margin:                      0px;
    padding:                     8px;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @fg;
}

element selected {
    background-color:            @selected;
    text-color:                  @accent;
}

element-icon {
    size:                        32px;
    background-color:            transparent;
}

element-text {
    vertical-align:              0.5;
    background-color:            transparent;
    text-color:                  inherit;
}
