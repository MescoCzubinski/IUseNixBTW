{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "ipc": true,
    "exclusive": true,
    "passthrough": false,
    "height": 40,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 12,

    "modules-left": ["clock", "mpris"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "bluetooth",
        "battery",
        "network"
    ],

    "clock": {
        "interval": 1,
        "format": "󰥔 <span>{:%H:%M}</span>"
    },
    
    "mpris": {
        "format": "{player_icon} <span>{artist} – {title}</span>",
        "format-paused": "{status_icon} <span>{artist} – {title}</span>",
        "player-icons": {
            "default": "▶",
            "spotify": ""
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "max-length": 35,
        "ellipsis": ".."
    },
    
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "A",
            "2": "B",
            "3": "C",
            "4": "D",
            "5": "E",
            "default": ""
        }
    },

    "bluetooth": {
        "format": "󰂯 <span>Enabled</span>",
        "format-disabled": "󰂯 <span>Disabled</span>",
        "format-connected": "󰂯 <span>{device_alias}</span>",
        "tooltip": false,
        "on-click": "blueman-manager"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "󰛨 <span>{percent}%</span>",
        "tooltip": false,
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
    },

    "pulseaudio": {
        "format": "󰕾 <span>{volume}%</span>",
        "format-muted": "󰖁 <span>{volume}%</span>",
        "tooltip": false,
        "on-click": "pavucontrol",
        "scroll-step": 1
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 10
        },
        "format": "{icon} <span>{capacity}%</span>",
        "format-charging": "󱐋 <span>{capacity}%</span>",
        "format-plugged": " <span>{capacity}%</span>",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": false
    },

    "network": {
        "format-wifi": "  <span>{essid}</span>",
        "format-ethernet": "󰈀 <span>Ethernet</span>",
        "format-disconnected": "󰖪 ",
        "tooltip": false,
        "on-click": "nm-connection-editor"
    }
}
